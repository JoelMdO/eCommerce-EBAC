{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "module": "es2022",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["jest", "node", "@testing-library/jest-dom", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
